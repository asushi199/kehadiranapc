# Public Supabase project details. The publishable key may be exposed to browsers,
# but public browser code must never query the participants table directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
IC_HMAC_SECRET=
LOOKUP_TOKEN_SECRET=
STAFF_ACCESS_PASSWORD=
MASTER_ACTION_PASSWORD=
EMCEE_VIEW_TOKEN=

# Application settings
APP_TIME_ZONE=Asia/Kuala_Lumpur
NEXT_PUBLIC_APP_NAME=APC 2025
